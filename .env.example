# ローカル用: このファイルをコピーして `.env.local` を作成してください
# Netlify でも同名の環境変数を設定してください

# レシピ URL / 写真 / YouTube 取り込み（サーバー側のみ。クライアントに露出させない）
OPENAI_API_KEY=
OPENAI_RECIPE_IMPORT_MODEL=gpt-4o-mini

# YouTube Data API（videos.list）。未設定時は YouTube 取込不可
YOUTUBE_API_KEY=

# 家族共有（任意。未設定時は localStorage のみで動作）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 任意: URL取り込みのデバッグ（本番では通常不要）
# RECIPE_IMPORT_DEBUG=1
